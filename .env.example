AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
TRANSCRIPTION_ENABLED=false
# Optional current USD prices per million tokens. Unset = cost unknown.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Browser-local recording retention: 0 = current tab session; max 168 hours.
AUDIO_RETENTION_HOURS=0

# Hostinger: enable the gate and set a long family-only code in hPanel.
PRACTICE_GATE_ENABLED=true
PRACTICE_ACCESS_CODE=
